{
  "name": "llm-diplomacy-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:fixtures": "python scripts/build_fixtures.py",
    "build:catalog": "npm run build:catalog:generated",
    "build:catalog:generated": "node --experimental-strip-types scripts/build_report_catalog.ts --source-root fixtures/phase4a_generated --output-root public/reports --force",
    "build:catalog:fixtures": "node --experimental-strip-types scripts/build_report_catalog.ts --source-root fixtures --output-root public/reports --fixture --force",
    "build:catalog:production": "node --experimental-strip-types scripts/build_report_catalog.ts",
    "stage:public-reports": "node --experimental-strip-types scripts/public_build.ts stage --output-root public-build-input",
    "verify:public-stage": "node --experimental-strip-types scripts/public_build.ts verify-stage",
    "build:public": "npm run verify:public-stage && npm run typecheck && vite build --mode public",
    "verify:public-build": "node --experimental-strip-types scripts/public_build.ts verify-build --dist-root dist-public --forbidden-source-root fixtures/phase4a_generated --audit-path public-build-audits/verification-audit.json",
    "preview:public": "npm run verify:public-build && vite preview --outDir dist-public --host 127.0.0.1",
    "test:e2e:public": "node --experimental-strip-types scripts/run_public_e2e.ts",
    "build:narrative": "node --experimental-strip-types scripts/build_narratives.ts",
    "build:audiences": "node --experimental-strip-types scripts/build_audience_projections.ts",
    "validate:narrative": "node --experimental-strip-types scripts/validate_narrative.ts",
    "package:report": "node --experimental-strip-types scripts/package_report.ts",
    "archive:report": "python scripts/archive_report.py create",
    "verify:archive": "python scripts/archive_report.py verify",
    "verify:archive:browser": "node --experimental-strip-types scripts/verify_report_archive.ts",
    "reproduce:sample": "node --experimental-strip-types scripts/package_report.ts --catalog fixtures/reproducibility-v1.catalog.json --audience omniscient_postgame --report-ids game_001",
    "verify:reproducibility": "vitest run tests/reproducibility-docs.test.ts",
    "legacy:build:public-release": "node --experimental-strip-types scripts/build_public_release.ts",
    "legacy:serve:public-release": "node --experimental-strip-types scripts/serve_public_release.ts",
    "validate:schema": "node --experimental-strip-types scripts/validate_schema.ts fixtures/game_001/report.json fixtures/game_002/report.json",
    "validate:fixtures": "node --experimental-strip-types scripts/validate_bundle.ts fixtures/game_001/report.json fixtures/game_002/report.json",
    "audit:fixtures": "python scripts/audit_fixture_integrity.py",
    "verify:raw-fixtures": "python scripts/verify_raw_fixture_toolchain.py",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "test:unit": "vitest run --exclude tests/portable-archive-navigation.test.ts",
    "pretest:e2e": "npm run build:catalog",
    "test:e2e": "playwright test",
    "pretest:e2e:update": "npm run build:catalog",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:legacy": "npm run validate:schema && npm run validate:fixtures && node --test --experimental-strip-types tests/contract.test.ts && npm run test:unit",
    "test": "node --test --experimental-strip-types tests/portable-years.test.ts && vitest run tests/portable-years-ui.test.tsx tests/portable-public-build.test.ts",
    "test:archive-browser": "vitest run tests/portable-archive-navigation.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.source.json --noEmit",
    "test:full-postgame": "vitest run tests/full-postgame-policy.test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  }
}
